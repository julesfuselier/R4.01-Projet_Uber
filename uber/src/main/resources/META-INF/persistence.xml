<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="UberPU" transaction-type="JTA">
        <!-- Remplacer par le nom JNDI configuré dans GlassFish -->
        <!-- <jta-data-source>jdbc/uberDB</jta-data-source> -->
        <properties>
            <!-- Permet de générer les tables automatiquement au déploiement -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>